---
// The document shell, replacing SvelteKit's src/app.html. Everything in here is
// prerendered into dist/index.html, so the frame and the splash paint before a
// single byte of JavaScript is parsed.
import '../styles/app.css';

interface Props {
  title?: string;
}

const {title = 'Web S'} = Astro.props;
---

<!doctype html>
<!-- `data-ui` names the skin `styles/app.css` draws (and is the handle its
     overrides use to outrank the ported component stylesheets — see that file's
     header). It is static, so the skin is settled before the first paint. -->
<html lang="en" data-ui="native">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- The client's own mark (see components/logoGeometry.ts): the SVG where it
         is understood, the square PNG for the platforms that want one. -->
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Web S" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
